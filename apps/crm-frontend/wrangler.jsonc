{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "crm-frontend",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crm-frontend"
    }
  ],
  // NEXT_PRIVATE_MINIMAL_MODE=1: without it, Next.js's own
  // getMiddlewareManifest() does a dynamic require() of
  // middleware-manifest.json at request time, which crashed every route in
  // the real deployed user-frontend Worker (same middleware.ts pattern
  // exists here) — minimal mode skips that require() entirely. Confirmed
  // via opennextjs-cloudflare#922/#1232, a known open bug, not something
  // fixable in application code.
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // RECAPTCHA_SITE_KEY_PUBLIC / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are
    // public-by-design (meant to reach the browser), safe committed here —
    // same values as apps/crm-frontend/.env.local.
    "RECAPTCHA_SITE_KEY_PUBLIC": "6Ldpv5YtAAAAAIO-97P3-NdJXt3y-M2DvvMcTtZz",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51T0j1AHKkZtApjEZUSOwHNPoXQGqZZ0ZVZ1yYag5x5QJzo0Fk7JPwWqppkITmSeQFrrbMCihTTplH9dGuK5P8WEl00fgW1maIT",
    // Points at the real deployed crm-backend Worker (Worker-to-Worker
    // fetch, not crossing into Render) — matches user-frontend's pattern of
    // pointing BACKEND_URL at its matching backend rather than falling back
    // to the old Render-hosted backend, which Cloudflare's edge rejects
    // (error 1003, "Direct IP Access Not Allowed").
    "BACKEND_URL": "https://cbfx-crm-backend.tradeversesocial.workers.dev"
  }
}
