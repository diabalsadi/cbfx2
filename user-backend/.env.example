# user-backend needs everything crm-backend needs, plus Stripe billing —
# the one secret set that's genuinely exclusive to this service (billing.py
# and internal.py's /sync-subscriptions have no crm-backend equivalent).

DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
# Must be the exact same value as crm-backend's JWT_SECRET — a token minted
# by either service's /auth/login must be valid on both (role="client" dual
# portal case).

ALLOW_DEV_IP_OVERRIDE=true

# MetaApi (MT5 account provisioning, mt5_accounts.py) + CopyFactory
# (copy-trading sync, internal.py's /keep-alive-copytrading).
METAAPI_TOKEN=your_metaapi_token_here

# Encrypts MT5 investor passwords at rest (mt5_accounts.py). Must be the
# exact same value as crm-backend's FIELD_ENCRYPTION_KEY, backend/'s, and
# backend-shared's Fernet key — rotating it independently per service would
# make rows encrypted by one service unreadable by another.
FIELD_ENCRYPTION_KEY=your_fernet_key_here

# Guards every /internal/* endpoint's X-Sync-Key/X-Sync-Secret headers
# (/sync-metaapi, /keep-alive-copytrading, /sync-subscriptions, /purge-cache
# — all four live here).
METAAPI_SYNC_KEY=your_sync_key_here
METAAPI_SYNC_SECRET=your_sync_secret_here

# Cloudflare R2 (S3-compatible) — forum image uploads (forum.py).
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tradeverse
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cloudflare Workers KV — backs public_cache, called on mutation across
# most routers here. If unset, caching silently no-ops rather than failing
# hard.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_KV_API_TOKEN=your_workers_kv_edit_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id

RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Signup/reset OTP emails (auth.py's full register + forgot-password flow).
SYSTEM_EMAIL_ID=your_smtp_email_here
SYSTEM_EMAIL_PASSWORD=your_smtp_app_password_here
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465

# Machine-translates public content (forum.py's list/detail). If unset,
# translation silently no-ops — never a hard failure.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Stripe — the Signals + Copy Trading subscription paywall. This service
# only: billing.py and internal.py's /sync-subscriptions. Prefer a
# restricted key (rk_...) scoped to Checkout Sessions, Customers, and
# Subscriptions (read) over a full secret key (sk_...).
STRIPE_SECRET_KEY=your_stripe_restricted_or_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_PRICE_ID=your_stripe_monthly_price_id
