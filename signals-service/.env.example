DATABASE_URL=your_database_url_here
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.7-flash
TASK_AUTH_TOKEN=a_long_random_shared_secret

# Used to call POST /internal/purge-cache on the main backend after any
# generate/monitor run that changes a plays row — same credentials the
# MetaApi sync cron already uses (backend/app/routers/internal.py). Optional:
# if left unset, cache purging is skipped (logged, not fatal).
BACKEND_BASE_URL=https://your-backend.example.com
METAAPI_SYNC_KEY=same_value_as_the_main_backends_METAAPI_SYNC_KEY
METAAPI_SYNC_SECRET=same_value_as_the_main_backends_METAAPI_SYNC_SECRET
