# crm-backend needs almost everything backend/ needs — verified by grepping
# actual imports, not assumed from plan.md's simplified "MetaApi/Stripe sync
# keys on user-backend only" framing. copy_traders.py (MetaApi/CopyFactory +
# FIELD_ENCRYPTION_KEY), media.py/broker_reports.py (R2), analysis.py/
# public.py (Google Translate), and internal.py's /purge-cache (which reuses
# METAAPI_SYNC_KEY/SECRET for its own auth) all live here. Only Stripe
# billing is genuinely user-backend-only (crm-backend has no billing.py).

DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
# Must be the exact same value as user-backend's JWT_SECRET — a token minted
# by either service's /auth/login must be valid on both (role="client" dual
# portal case).

ALLOW_DEV_IP_OVERRIDE=true

# MetaApi (MT5 account provisioning) + CopyFactory (copy-trading strategies)
# — used by copy_traders.py.
METAAPI_TOKEN=your_metaapi_token_here

# Encrypts investor passwords at rest (copy_traders.py). Must be the exact
# same value as user-backend's FIELD_ENCRYPTION_KEY, backend/'s, and
# backend-shared's Fernet key — rotating it independently per service would
# make rows encrypted by one service unreadable by another.
FIELD_ENCRYPTION_KEY=your_fernet_key_here

# Guards every /internal/* endpoint's X-Sync-Key/X-Sync-Secret headers —
# crm-backend only exposes /internal/purge-cache, but it reuses these same
# credentials rather than a separate secret.
METAAPI_SYNC_KEY=your_sync_key_here
METAAPI_SYNC_SECRET=your_sync_secret_here

# Cloudflare R2 (S3-compatible) — admin Media Manager (media.py) and broker
# report uploads (broker_reports.py).
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tradeverse
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cloudflare Workers KV — backs public_cache, called by nearly every router
# here on mutation (purge_public_cache()). If unset, caching silently
# no-ops rather than failing hard.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_KV_API_TOKEN=your_workers_kv_edit_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id

RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Signup/reset OTP + broker welcome emails (auth.py, brokers.py).
SYSTEM_EMAIL_ID=your_smtp_email_here
SYSTEM_EMAIL_PASSWORD=your_smtp_app_password_here
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465

# Machine-translates public content (analysis.py, public.py). If unset,
# translation silently no-ops — never a hard failure.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
