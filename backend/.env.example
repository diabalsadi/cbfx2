DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
X-RapidAPI-Key-seeking-alpha=your_rapidapi_key_here

# Signup OTP emails (Gmail SMTP by default — SYSTEM_EMAIL_ID must be a Gmail
# address and SYSTEM_EMAIL_PASSWORD a Gmail App Password, not the account
# password). Override SMTP_HOST/SMTP_PORT to use a different provider.
SYSTEM_EMAIL_ID=your_smtp_email_here
SYSTEM_EMAIL_PASSWORD=your_smtp_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) on the login and signup
# forms. Secret key from https://www.google.com/recaptcha/admin — pair it
# with NEXT_PUBLIC_RECAPTCHA_SITE_KEY in frontend/.env.local.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Cloudflare R2 (S3-compatible) storage for the admin Media Manager.
# R2_ENDPOINT is the account-level S3 API endpoint (no bucket in the host),
# e.g. https://<account_id>.r2.cloudflarestorage.com — NOT the bucket's
# public URL. Access key/secret come from an R2 API token (Cloudflare
# dashboard → R2 → Manage API Tokens) with read/write on this bucket.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tradeverse
# Public base URL images are served from — the bucket's r2.dev URL (enable
# "Public Development URL" on the bucket in the Cloudflare dashboard) or a
# custom domain attached to it. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
