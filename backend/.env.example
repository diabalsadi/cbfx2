DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
X-RapidAPI-Key-seeking-alpha=your_rapidapi_key_here

# Signup OTP emails — works with any SMTP provider, defaults shown below are
# for Gmail. SYSTEM_EMAIL_PASSWORD must be an app-specific password (Gmail App
# Password / Zoho App Password / etc.), not the account's login password.
# SMTP_PORT=465 is treated as implicit TLS (SMTP_SSL); anything else uses
# STARTTLS — pick whichever your provider's docs list for that port.
# Zoho Mail (free/standard): SMTP_HOST=smtp.zoho.com, SMTP_PORT=587.
# Zoho Mail (Pro, or accounts issued smtppro.zoho.com creds): SMTP_HOST=
# smtppro.zoho.com, SMTP_PORT=465. (smtp.zoho.eu / smtp.zoho.in etc. instead
# of .com depending on your account's data center.) Generate the app
# password at accounts.zoho.com → Security → App Passwords.
SYSTEM_EMAIL_ID=your_smtp_email_here
SYSTEM_EMAIL_PASSWORD=your_smtp_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) on the login and signup
# forms. Secret key from https://www.google.com/recaptcha/admin — pair it
# with RECAPTCHA_SITE_KEY_PUBLIC in frontend/.env.local.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Cloud Translation API v2 (Basic) — server-only API key used to
# machine-translate public content (articles, forum posts, analysis
# summaries, ad banners, SEO copy) into the visitor's detected locale on
# read. Enable "Cloud Translation API" on the project, then create/restrict
# an API key at https://console.cloud.google.com/apis/credentials (restrict
# it to that API only). If unset, translation silently no-ops and every
# response is served in the original English — never a hard failure.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Cloudflare R2 (S3-compatible) storage for the admin Media Manager.
# R2_ENDPOINT is the account-level S3 API endpoint (no bucket in the host),
# e.g. https://<account_id>.r2.cloudflarestorage.com — NOT the bucket's
# public URL. Access key/secret come from an R2 API token (Cloudflare
# dashboard → R2 → Manage API Tokens) with read/write on this bucket.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tradeverse
# Public base URL images are served from — the bucket's r2.dev URL (enable
# "Public Development URL" on the bucket in the Cloudflare dashboard) or a
# custom domain attached to it. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cloudflare Workers KV — backs backend_shared.utils.cache.public_cache (every
# /public/* read) and the Google Translate response hot-cache. CF_ACCOUNT_ID
# is the same account R2 lives in. CF_KV_API_TOKEN needs "Workers KV
# Storage: Edit" permission (Cloudflare dashboard → My Profile → API Tokens
# → Create Token), scoped to this account. All three are required — if any
# is unset, caching silently no-ops (every request recomputes) rather than
# failing hard.
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_KV_API_TOKEN=your_workers_kv_edit_api_token
# The "tradeverse" namespace.
CF_KV_NAMESPACE_ID=3c7882abcf624867a9de32d3f12c6d84

# Stripe — the combined Signals + Copy Trading subscription paywall (see
# registering the webhook endpoint, and generating a restricted API key).
# Prefer a restricted key (rk_...) scoped to Checkout Sessions, Customers,
# and Subscriptions (read) over a full secret key (sk_...).
STRIPE_SECRET_KEY=your_stripe_restricted_or_secret_key
# From the webhook endpoint's "Signing secret" in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
# The recurring monthly Price ID for the combined subscription product —
# $25 USD/month (frontend/components/ProGate displays this price, keep in sync).
STRIPE_PRICE_ID=your_stripe_monthly_price_id
